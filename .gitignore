# ============================================================================
# Tauri Generated (platform-specific, rebuilt on each machine)
# ============================================================================
# Uncomment below if you don't want to commit generated mobile configs
# examples/tauri-app/src-tauri/gen/android/
# examples/tauri-app/src-tauri/gen/apple/

# Always ignore build artifacts within gen
**/gen/android/.gradle/
**/gen/android/build/
**/gen/android/app/build/
**/gen/android/**/build/
**/gen/apple/build/
**/gen/apple/*/build/

